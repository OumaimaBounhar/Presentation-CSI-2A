  %
  % Symboles de navigation si besoin.
  %\iftpt@navsymbols
  %\begin{beamercolorbox}%
  %  [wd=\@tempdima,\tpt@navsymbols@align]{navigation symbols}
  %  \usebeamertemplate***{navigation symbols}%
  %\end{beamercolorbox}
  %\fi
